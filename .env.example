# Optional server-side Gemini credentials. Never commit real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional platform credential. Free mode restricts routing to zero-price models.
OPENROUTER_API_KEY=
# Exact comma-separated public HTTPS API bases authorized for custom models/LiteLLM.
# Example: https://llm.example.org/v1
AI_CUSTOM_ENDPOINTS=
